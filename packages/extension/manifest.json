{
  "manifest_version": 3,
  "name": "autoBrowser",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "autoBrowser"
  }
}
